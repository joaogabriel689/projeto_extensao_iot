# ==============================================================================
# NORMALIZAÇÃO DE QUEBRAS DE LINHA (INTERCAMBIABILIDADE LINUX <-> WINDOWS)
# Garante que scripts, configurações e código mantenham LF mesmo no Windows,
# evitando falhas em contêineres Docker Linux montados via bind-mount.
# ==============================================================================
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ino text eol=lf
*.h text eol=lf
*.ini text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# Arquivos binários
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
