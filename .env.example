# ==============================================================================
# SISTEMA COUTOS CONVENIÊNCIA - AUTOMAÇÃO TÉRMICA RESILIENTE (IoT + MQTT)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente:
#   Linux/macOS: cp .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURAÇÕES GERAIS E FAIXA DE TEMPERATURA PADRÃO
# ------------------------------------------------------------------------------
TZ=America/Campo_Grande
DEFAULT_DEVICE_ID=camara01
DEFAULT_DEVICE_NAME=Camara Fria Principal - Coutos Conveniencia

# Faixa ideal inicial (definível pelo usuário via API ou variáveis de ambiente)
# Se a temperatura sair desta faixa (abaixo de MIN ou acima de MAX), envia alerta
DEFAULT_MIN_TEMP_C=-10.0
DEFAULT_MAX_TEMP_C=5.0

# Intervalo mínimo (em segundos) entre notificações repetidas do mesmo alerta
# para evitar spam no WhatsApp do comerciante (ex: 300s = 5 minutos)
ALERT_COOLDOWN_SECONDS=300

# ------------------------------------------------------------------------------
# 2. BROKER MQTT (Eclipse Mosquitto)
# ------------------------------------------------------------------------------
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_HOST_PORT=1884
MQTT_WS_HOST_PORT=9002
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=loja/freezer

# ------------------------------------------------------------------------------
# 3. BANCO DE DADOS POSTGRESQL (Admin + Roles Dedicadas de Menor Privilégio)
# ------------------------------------------------------------------------------
POSTGRES_USER=coutos_admin
POSTGRES_PASSWORD=troque_esta_senha_segura_123
POSTGRES_DB=coutos_telemetria
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# Usuário dedicado exclusivo para o Backend de Telemetria (sem SUPERUSER)
POSTGRES_APP_USER=telemetry_app_user
POSTGRES_APP_PASSWORD=troque_senha_app_telemetria_123

# Banco e usuário dedicado exclusivo para a Evolution API (isolamento total)
EVOLUTION_DB_NAME=evolution_db
EVOLUTION_DB_USER=evolution_app_user
EVOLUTION_DB_PASSWORD=troque_senha_app_evolution_123

# ------------------------------------------------------------------------------
# 4. BACKEND API, PAINEL WEB RESTRITO & BUFFER LOCAL TOLERANTE A FALHAS
# ------------------------------------------------------------------------------
BACKEND_HOST_PORT=8000
LOCAL_BUFFER_DB_PATH=/app/data/offline_buffer.sqlite3
REPLAY_INTERVAL_SECONDS=10

# Credenciais de Login do Painel Web (http://localhost:8000)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=troque_senha_painel_segura_123

# Chave de segurança para proteção de endpoints administrativos da API e assinatura HMAC-SHA256 de OTA
API_SECRET_KEY=troque_por_uma_chave_aleatoria_segura
OTA_SHARED_SECRET=coutos_ota_hmac_secret_2026

# ------------------------------------------------------------------------------
# 5. NOTIFICAÇÕES WHATSAPP (Evolution API v2)
# ------------------------------------------------------------------------------
EVOLUTION_HOST_PORT=8081
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=troque_sua_evolution_global_api_key
EVOLUTION_INSTANCE_NAME=coutos_alertas

# Número do comerciante que receberá os alertas no WhatsApp (DDI + DDD + Número)
# Exemplo Brasil (Campo Grande - DDD 67): 5567999999999
MERCHANT_WHATSAPP_NUMBER=5567999999999
WHATSAPP_NOTIFICATIONS_ENABLED=true
